{
  "name": "dsh-annotate-browser",
  "version": "0.2.3",
  "type": "module",
  "description": "DSH 插件：在自己掌握的面板里标注浏览器页面元素，注释随对话一起发出",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "smoke": "node test/cdp-smoke.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zengxiaolou/dsh-annotate-browser"
  },
  "homepage": "https://github.com/zengxiaolou/dsh-annotate-browser",
  "bugs": {
    "url": "https://github.com/zengxiaolou/dsh-annotate-browser/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ]
}
